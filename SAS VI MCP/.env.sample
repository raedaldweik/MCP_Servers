# SAS Visual Investigator MCP server — environment
#
# In SAS Retrieval Agent Manager these go on the Container MCP Server
# template's Environment Variables tab (mark the ones flagged "secret").
# Every VI_* name also accepts the SAS Viya MCP's name (VIYA_ENDPOINT,
# VIYA_REFRESH_TOKEN, CLIENT_ID, CLIENT_SECRET, SSL_VERIFY), so that
# template's table can be copied across unchanged.

# Required — the VI base URL, or its cloudflared tunnel URL when the image
# (RACE / Engage) is not reachable from RAM.                        [secret]
VI_ENDPOINT=

# ---------------------------------------------------------------------------
# Headless authentication — pick ONE
# ---------------------------------------------------------------------------
# Option 1 (recommended) — refresh token. Obtain it once with
#   uv run vi-get-refresh-token            (add --insecure for RACE/Engage)
# It carries the full identity of the user who signed in, works for SSO /
# federated accounts (the password grant cannot), and the server renews
# access tokens from it automatically. Takes precedence over Option 2.
#                                                                   [secret]
VI_REFRESH_TOKEN=

# The OAuth client the refresh token was issued to. Leave at sas.cli unless
# you registered a dedicated client with `vi-register-client` (default id
# sas-vi-mcp) or reused the SAS Viya MCP's `sas-mcp` client.
VI_CLIENT_ID=sas.cli
# Only for a confidential client (one registered with a secret).
VI_CLIENT_SECRET=

# Option 2 — username/password (password grant). Only for accounts SAS
# Logon authenticates directly (local/LDAP users on a RACE image); used only
# when VI_REFRESH_TOKEN is empty.
VI_USERNAME=
VI_PASSWORD=

# ---------------------------------------------------------------------------
# Connection
# ---------------------------------------------------------------------------
# false for RACE/Engage self-signed certificates and quick tunnels.
VI_SSL_VERIFY=true
VI_TIMEOUT=120
# Override only if an ingress rewrites the VI service paths.
# VI_ALERT_BASE=/svi-alert
# VI_DATAHUB_BASE=/svi-datahub
# VI_SAND_BASE=/svi-sand
# VI_WORKFLOW_BASE=/svi-datahub/workflows

# ---------------------------------------------------------------------------
# Behaviour
# ---------------------------------------------------------------------------
# Write tools (dispositions, alert actions, workflow completion) stay refused
# unless this is true.
VI_ALLOW_ACTIONS=false
# One line describing the deployment, surfaced by get_investigation_scope.
VI_USE_CASE=Procurement integrity monitoring: alerts on suppliers, tenders and payments flagged by detection scenarios, with entity networks and workflows for investigation.
# Cap on any single tool response (characters).
VI_MAX_CHARS=16000

# ---------------------------------------------------------------------------
# Serving (container)
# ---------------------------------------------------------------------------
HOST_PORT=8141
# http (streamable HTTP at /mcp, what RAM uses) or sse (/sse).
MCP_TRANSPORT=http
# Optional static key protecting /mcp (X-API-Key or Bearer). RAM reaches the
# container in-cluster, so it is usually left empty.
MCP_API_KEY=
# Which server the container runs: http-direct (default, for RAM) or stdio.
MCP_MODE=http-direct
LOG_LEVEL=INFO
